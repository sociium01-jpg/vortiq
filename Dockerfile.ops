# Stage 1: Build Standalone Ops Backend
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build:ops

# Stage 2: Production Web Server (NGINX)
FROM nginx:alpine

# Copy custom NGINX configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled ops distribution files (dist-ops) from builder
COPY --from=builder /app/dist-ops /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
